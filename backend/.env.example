# Copy this file to backend/.env and fill in ONE key. backend/.env is git-ignored; never commit real keys.
# With no key, the app runs on the free, offline scripted orchestrator.

# Free: https://console.groq.com -> API Keys (no credit card; rate-limited)
GROQ_API_KEY=

# Paid, best quality: https://console.anthropic.com -> API keys (starts with sk-ant-api03-)
ANTHROPIC_API_KEY=

# Optional overrides
# EMSOLVER_PROVIDER=groq            # claude | groq | bigpickle | scripted (default: first key found)
# EMSOLVER_GROQ_MODEL=openai/gpt-oss-120b
# EMSOLVER_MODEL=claude-opus-5-5
